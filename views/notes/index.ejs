<!-- Section: Page layout partials -->
<%- include('../partials/header', { title: 'My Notes' }) %> <!-- Shared head/meta/styles -->
<%- include('../partials/nav', { currentUser }) %> <!-- Nav with current user context -->

<!-- Section: Notes page top area -->
<main class="container pb-4 notes-page">
  <section class="notes-topbar mb-4">
    <h1 class="notes-title m-0">My Notes</h1>
    <a class="btn btn-primary btn-sm notes-add-btn" href="#create-note">+ Add Note</a> <!-- Opens create section via anchor -->
  </section>

  <% if (error) { %> <!-- Show page-level error message -->
    <div class="alert alert-danger notes-flash" role="alert"><%= error %></div>
  <% } %>

  <% if (success) { %> <!-- Show success message after actions like create/delete -->
    <div class="alert alert-success notes-flash" role="alert" data-auto-dismiss="3000"><%= success %></div>
  <% } %>

  <!-- Section: Create note section -->
  <section
    id="create-note"
    class="card notes-create mb-4 <%= (error || values.title || values.content) ? 'notes-create--open' : '' %>"
  >
    <div class="card-body">
      <h2 class="h5">Create Note</h2>
      <form method="POST" action="/notes" data-form-type="note"> <!-- Create a new note -->
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            id="title"
            name="title"
            type="text"
            class="form-control"
            maxlength="200"
            value="<%= values.title %>"
            required
          />
        </div>

        <div class="mb-3">
          <label for="content" class="form-label">Content</label>
          <textarea
            id="content"
            name="content"
            class="form-control"
            rows="5"
            maxlength="5000"
          ><%= values.content %></textarea>
        </div>

        <p class="text-danger mb-3" data-form-error></p>

        <button type="submit" class="btn btn-primary">Create</button>
      </form>
    </div>
  </section>

  <!-- Section: Saved notes section -->
  <section>
    <% if (!notes.length) { %>
      <p class="text-muted">No notes yet. Create your first one above.</p>
    <% } %>

    <div class="notes-grid" id="notesGrid">
      <% notes.forEach((note) => { %>
        <!-- Section: Single note card -->
        <article
          class="card note-card"
          data-note-id="<%= note._id %>"
          data-is-pinned="<%= note.isPinned ? 'true' : 'false' %>"
          draggable="<%= note.isPinned ? 'true' : 'false' %>"
        >
          <!-- This card can be dragged to change note order -->
          <div class="card-body">
            <div class="note-card-header">
              <div class="note-title-wrap">
                <h3 class="note-title"><%= note.title %></h3>
                <% if (note.isPinned) { %>
                  <span class="badge text-bg-warning">Pinned</span>
                <% } %>
              </div>
              <button
                type="button"
                class="btn btn-outline-secondary btn-sm note-size-btn note-size-btn--corner"
                data-note-toggle-size
                aria-expanded="false"
                aria-label="Expand note"
                title="Expand"
              >
                🗖
              </button>
            </div>

            <p class="mb-3 note-content-preview"><%= note.content %></p>

            <div class="note-card-footer">
              <div class="note-actions">
                <form method="POST" action="/notes/<%= note._id %>/pin" class="m-0">
                  <button type="submit" class="btn btn-outline-warning btn-sm">
                    <%= note.isPinned ? 'Unpin' : 'Pin' %>
                  </button>
                </form>
                <a href="/notes/<%= note._id %>/edit" class="btn btn-light btn-sm">Edit</a>
                <form method="POST" action="/notes/<%= note._id %>/delete" class="m-0" data-delete-note-form> <!-- Delete this one note after confirmation. -->
                  <button
                    type="button"
                    class="btn btn-danger btn-sm"
                    data-delete-confirm-trigger
                    data-note-title="<%= note.title %>"
                  >
                    Delete
                  </button> <!-- Pass note title into modal for clear delete confirmation. -->
                </form>
              </div>
              <time
                class="note-date"
                datetime="<%= note.updatedAt ? note.updatedAt.toISOString() : '' %>"
              >
                <%= new Date(note.updatedAt || note.createdAt).toLocaleDateString() %>
              </time> <!-- Keep machine-readable date for accessibility/tools. -->
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<!-- Section: Delete note confirmation modal -->
<div class="modal fade" id="deleteNoteConfirmModal" tabindex="-1" aria-labelledby="deleteNoteConfirmTitle" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm"> <!-- Small modal keeps confirmation compact. -->
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="deleteNoteConfirmTitle">Delete note?</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-1">This action cannot be undone.</p>
        <p class="mb-0"><strong id="deleteNoteConfirmName"></strong></p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="confirmDeleteNoteButton">Delete</button>
      </div>
    </div>
  </div>
</div>

<!-- Section: Shared scripts/footer partial -->
<%- include('../partials/footer', { includeValidationScript: true, includeNotesUiScript: true }) %> <!-- Load form + notes page scripts -->
