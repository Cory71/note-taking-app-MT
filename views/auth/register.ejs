<!-- Section: Page layout partials -->
<%- include('../partials/header', { title: 'Register' }) %> <!-- Shared head/meta/styles -->
<%- include('../partials/nav', { currentUser: null }) %> <!-- Render guest nav for auth page -->

<!-- Section: Register page card -->
<main class="container pb-4 auth-page">
  <section class="card mx-auto auth-card auth-login-card">
    <div class="card-body">
      <h1 class="h4 mb-3 text-center">Create Account</h1>

      <% if (error) { %> <!-- Show register error from server -->
        <div class="alert alert-danger" role="alert"><%= error %></div>
      <% } %>

      <!-- Section: Register form -->
      <form method="POST" action="/register" data-form-type="register"> <!-- Browser script picks register rules by this value -->
        <div class="mb-3">
          <label for="username" class="form-label visually-hidden">Username</label>
          <input
            id="username"
            name="username"
            type="text"
            class="form-control auth-input"
            placeholder="Username"
            value="<%= values.username %>"
            required
          />
        </div>

        <div class="mb-3">
          <label for="email" class="form-label visually-hidden">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            class="form-control auth-input"
            placeholder="Email"
            value="<%= values.email %>"
            required
          />
        </div>

        <div class="mb-3">
          <label for="password" class="form-label visually-hidden">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            class="form-control auth-input"
            placeholder="Password"
            minlength="6"
            pattern="(?=.*[A-Za-z])(?=.*[0-9]).+"
            title="Use at least 6 characters with at least one letter and one number."
            required
          />
          <!-- Same password rule as server: at least one letter and one number -->
          <div class="form-text">Use at least 6 characters with at least one letter and one number.</div>
        </div>

        <div class="form-check mb-3"> <!-- Optional show/hide password toggle -->
          <input
            id="showRegisterPasswordToggle"
            type="checkbox"
            class="form-check-input"
            data-password-toggle
            data-password-target="#password"
          />
          <label for="showRegisterPasswordToggle" class="form-check-label">Show password</label>
        </div>

        <p class="text-danger mb-3" data-form-error></p>

        <button type="submit" class="btn btn-primary w-100 auth-submit-btn">Register</button>
      </form>

      <p class="mb-0 mt-3 text-center"> <!-- Link for users who already signed up -->
        Already have an account?
        <a href="/login">Log in</a>
      </p>
    </div>
  </section>
</main>

<!-- Section: Shared scripts/footer partial -->
<%- include('../partials/footer', { includeValidationScript: true }) %> <!-- Load shared scripts + validation -->
