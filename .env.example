PORT=3000 # Local app port (Render sets this automatically in production)
# MongoDB Atlas connection string (production). Get it from Atlas > Connect > Drivers:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/note-taking-app-mt?retryWrites=true&w=majority
# Local MongoDB example (development):
# MONGODB_URI=mongodb://127.0.0.1:27017/note-taking-app-mt
# Local MongoDB test DB example (recommended for running tests):
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/note-taking-app-mt-test
SESSION_SECRET= # Required for session cookies (use a long random string in production)

# Auth0
# Leave these blank if you only use local username/password login.
AUTH0_DOMAIN= # From your Auth0 application settings
AUTH0_CLIENT_ID= # Public client id from Auth0
AUTH0_CLIENT_SECRET= # Private client secret from Auth0
# Local: http://localhost:3000/auth/auth0/callback
# Production (Render): https://<your-app>.onrender.com/auth/auth0/callback
# This value MUST also be listed in the Auth0 dashboard's Allowed Callback URLs.
AUTH0_CALLBACK_URL=http://localhost:3000/auth/auth0/callback
